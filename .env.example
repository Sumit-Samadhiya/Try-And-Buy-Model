# ==========================================
# SevenShades Application Environment Configuration
# Copy this file to .env and supply actual secret values.
# NEVER commit .env to version control.
# ==========================================

# Django Core
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=your-django-secret-key-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Database Configuration (Leave DB_ENGINE empty for default local SQLite)
DB_ENGINE=
DB_NAME=sevenshades
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Cache & Channel Layers (Leave empty for LocMem and In-Memory channel layer)
REDIS_URL=

# Fast2SMS OTP Authentication (Leave empty for local DEBUG test mode with fixed OTP)
FAST2SMS_API_KEY=
OTP_TEST_MODE=1

# Razorpay Payment Gateway (Leave empty if running 100% Cash-on-Delivery)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Receipt & Store Metadata
RECEIPT_SELLER_NAME=SevenShades
RECEIPT_SELLER_ADDRESS=

# Rate Limiting Configuration
RATE_LIMIT_AUTH_IP_MAX=100
RATE_LIMIT_AUTH_IP_WINDOW=60
RATE_LIMIT_AUTH_ACC_MAX=10
RATE_LIMIT_AUTH_ACC_WINDOW=900
RATE_LIMIT_AUTH_BACKOFF_BASE=2.0
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX=300
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PUBLIC_WINDOW=60
RATE_LIMIT_AUTHED_MAX=300
RATE_LIMIT_AUTHED_WINDOW=60
